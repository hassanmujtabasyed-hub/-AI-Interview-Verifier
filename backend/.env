# AI Interview Verifier - Backend Environment Variables
# Copy to .env.local for machine-specific overrides (gitignored)

# Application
APP_NAME="AI Interview Verifier"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database (PostgreSQL)
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/interview_verifier"

# Security / JWT
# IMPORTANT: Generate a strong random secret for production!
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="dev-secret-key-change-in-production-min-32-characters-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200  # 30 days

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:5173"

# Rate limiting for sensitive endpoints (NFR-SEC-02) - 0 disables a check
# Login window is keyed by client IP + email; verify by user id.
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
# Must allow the per-second identity re-check (60/min) plus retry headroom
VERIFY_RATE_LIMIT=100
VERIFY_RATE_WINDOW_SECONDS=60